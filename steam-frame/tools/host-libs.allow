# The host libraries PrimedFrame may load from SteamOS (tools/check-bundle.sh).
# One soname or shell pattern per line.  Anything else a shipped binary or library needs must be in
# app/lib.  Every soname taken from the system must also be named in every SteamOS build listed in
# tools/host-sonames/ (check-bundle.sh fails otherwise), so this list is the rule and those files are the
# proof.  Nothing here is ever bundled.  Started from Moonlight XR for Frame's list and cut down to what
# the game, the launcher, Qt and its plugins really need.

# glibc: the base of the system (libmvec is glibc's vector math library, in all three SteamOS lists).  The program is built against 2.39, the oldest SteamOS has had.
libc.so.6
libm.so.6
libmvec.so.1
ld-linux-aarch64.so.1
libdl.so.2
libpthread.so.0
librt.so.1
libresolv.so.2
libutil.so.1
# the compiler runtime: libstdc++ and libgcc_s are one with glibc on SteamOS (GCC 15), and the program and Qt
# are built with GCC 13, whose symbols all exist there; libatomic is part of the same package
libstdc++.so.6
libgcc_s.so.1
libatomic.so.1
# graphics: the glvnd dispatch libraries with Mesa behind them, and the Vulkan loader.  They are the
# system's driver stack and must match the GPU driver, so they are never bundled.
libGL.so.1
libEGL.so.1
libGLX.so.0
libOpenGL.so.0
libGLdispatch.so.0
libvulkan.so.1
# the session: Wayland, X11, xcb and xkbcommon, which Qt's platform plugins talk to the display server with
libwayland-client.so.0
libwayland-cursor.so.0
libwayland-egl.so.1
libX11.so.6
libX11-xcb.so.1
libxcb*.so.[0-9]*
libxkbcommon.so.0
libxkbcommon-x11.so.0
libSM.so.6
libICE.so.6
# the desktop: D-Bus (Qt's DBus module), GLib (Qt's event dispatcher and network information)
libdbus-1.so.3
libglib-2.0.so.0
libgobject-2.0.so.0
libgio-2.0.so.0
libgmodule-2.0.so.0
# audio: Qt Multimedia links the PulseAudio client library (PipeWire serves it on SteamOS)
libpulse.so.0
# text: Qt draws with the system's fontconfig and FreeType
libfontconfig.so.1
libfreetype.so.6
# long-stable libraries the system itself is built on (same soname on every build)
libz.so.1
libzstd.so.1
libexpat.so.1
libpng16.so.16
libharfbuzz.so.0
libbrotlidec.so.1
libbrotlicommon.so.1
